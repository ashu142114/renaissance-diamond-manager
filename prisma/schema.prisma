generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

model Diamond {
  id               String   @id @default(cuid())
  shop             String
  certificate      String
  type             String
  shape            String
  carat            Decimal  @db.Decimal(7, 3)
  color            String
  clarity          String
  cut              String
  polish           String?
  symmetry         String?
  fluorescence     String?
  lab              String
  priceCents       Int
  stock            Int      @default(1)
  status           String   @default("ACTIVE")
  imageUrl         String?
  videoUrl         String?
  reportUrl        String?
  sku              String?
  shopifyProductId String?
  shopifyVariantId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([shop, certificate])
  @@index([shop, type, status])
  @@index([shop, shape, carat])
  @@index([shop, priceCents])
}

model ImportJob {
  id         String        @id @default(cuid())
  shop       String
  fileName   String
  status     String        @default("PREVIEW")
  totalRows  Int
  validRows  Int
  errorRows  Int
  payload    Json
  createdAt  DateTime      @default(now())
  committedAt DateTime?
  errors     ImportError[]

  @@index([shop, createdAt])
}

model ImportError {
  id        String    @id @default(cuid())
  jobId     String
  rowNumber Int
  field     String?
  message   String
  rowData   Json?
  job       ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}
